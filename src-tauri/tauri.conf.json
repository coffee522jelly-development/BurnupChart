{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BurnUpChart",
  "version": "0.1.0",
  "identifier": "com.burnupchart.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Burn Up Chart",
        "width": 640,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ja-JP"
      },
      "nsis": {
        "languages": ["Japanese"]
      }
    }
  }
}
